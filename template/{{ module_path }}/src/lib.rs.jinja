//! Replace the deterministic example with real model inference before publication.

// Stackful bindings preserve ordinary Rust code behind the async-typed embedding export.
wit_bindgen::generate!({ path: "wit", world: "embedding-provider", sync: true });

use exports::memcastle::embedding::provider::{Guest, Model};

struct Provider;

impl Guest for Provider {
    fn models() -> Vec<Model> {
        vec![Model {
            id: "sample".into(),
            dimensions: vec![3],
        }]
    }

    fn embed(
        model: String,
        dimensions: u32,
        _settings: String,
        texts: Vec<String>,
    ) -> Result<Vec<Vec<f32>>, String> {
        if model != "sample" || dimensions != 3 {
            return Err("unsupported model or dimension".into());
        }
        // A deterministic example exercises the contract without granting network or credentials.
        Ok(texts
            .iter()
            .map(|text| vec![text.len() as f32, 0.0, 1.0])
            .collect())
    }
}

export!(Provider);

#[cfg(test)]
mod tests {
    use super::{Guest, Provider};

    #[test]
    fn the_sample_returns_one_three_dimensional_vector_per_input() {
        assert_eq!(
            Provider::embed(
                "sample".into(),
                3,
                "{}".into(),
                vec!["hi".into(), "longer".into()],
            )
            .unwrap(),
            vec![vec![2.0, 0.0, 1.0], vec![6.0, 0.0, 1.0]]
        );
        let models = Provider::models();
        assert_eq!(models.len(), 1);
        assert_eq!(models[0].id, "sample");
        assert_eq!(models[0].dimensions, vec![3]);
    }

    #[test]
    fn an_empty_batch_returns_no_vectors() {
        assert!(
            Provider::embed("sample".into(), 3, "{}".into(), vec![])
                .unwrap()
                .is_empty()
        );
    }

    #[test]
    fn unsupported_models_and_dimensions_are_rejected() {
        assert!(Provider::embed("other".into(), 3, "{}".into(), vec![]).is_err());
        assert!(Provider::embed("sample".into(), 4, "{}".into(), vec![]).is_err());
    }
}
