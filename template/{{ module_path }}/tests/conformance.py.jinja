"""Execute the sample embedding component in an isolated Core daemon.

Run after building embedding.wasm, or pass a containing plugin archive and its IDs.
Adapt the sample profile/assertions together with your provider implementation.
"""

import argparse
import json
import os
import pathlib
import shutil
import socket
import subprocess
import tempfile
import time
import urllib.error
import urllib.request


def check(
    archive: pathlib.Path, plugin: str, module: str, binary: str, scratch: pathlib.Path
) -> None:
    config = scratch / "config.toml"
    config.write_text(
        '[embeddings.providers.smoke]\ntype = "plugin"\n'
        f"plugin = {json.dumps(plugin)}\nmodule = {json.dumps(module)}\n"
        '[embeddings.profiles.smoke]\nprovider = "smoke"\nmodel = "sample"\ndimensions = 3\n'
    )
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        port = listener.getsockname()[1]
    # No personal configuration, credentials or palace may leak into this test.
    env = {"HOME": str(scratch), "PATH": os.environ.get("PATH", "")}
    for kind in ("CONFIG", "DATA", "STATE", "CACHE"):
        env[f"XDG_{kind}_HOME"] = str(scratch / kind.lower())
    for key in ("SYSTEMROOT", "WINDIR", "COMSPEC", "PATHEXT", "TMPDIR", "TMP", "TEMP"):
        if key in os.environ:
            env[key] = os.environ[key]
    env["USERPROFILE"] = str(scratch)
    # Avoid proxy environment settings even when the caller has configured them.
    http = urllib.request.build_opener(urllib.request.ProxyHandler({}))

    def request(path: str, body: bytes | None = None, headers: dict | None = None):
        req = urllib.request.Request(
            f"http://127.0.0.1:{port}/api/{path}", body, headers or {}
        )
        try:
            with http.open(req, timeout=60) as response:
                return json.load(response)
        except urllib.error.HTTPError as error:
            raise RuntimeError(
                f"{path}: HTTP {error.code}: {error.read().decode()}"
            ) from error

    with (scratch / "daemon.log").open("w+") as log:
        daemon = subprocess.Popen(
            [
                binary,
                "--config",
                str(config),
                "--palace",
                str(scratch / "palace"),
                "serve",
                "--bind",
                "127.0.0.1",
                "--port",
                str(port),
            ],
            cwd=scratch,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
        )
        try:
            deadline = time.monotonic() + 30
            while True:
                if daemon.poll() is not None:
                    raise RuntimeError(
                        f"Core exited during startup: {daemon.returncode}"
                    )
                try:
                    request("health")
                    break
                except urllib.error.URLError:
                    if time.monotonic() >= deadline:
                        raise TimeoutError("Core was not ready within 30 seconds")
                    time.sleep(0.25)
            payload = archive.read_bytes()
            preview = request(
                "plugins/preview", payload, {"Content-Type": "application/octet-stream"}
            )
            if preview["id"] != plugin or preview["adoptions"]:
                raise ValueError(f"unexpected archive preview: {preview}")
            consents = {
                item["source"]: item["digest"]
                for item in preview["source_consents"] + preview["embedding_consents"]
            }
            request(
                "plugins",
                payload,
                {
                    "Content-Type": "application/octet-stream",
                    "X-MemCastle-Consents": json.dumps(consents),
                },
            )
            for text in ("a", "longer sample"):
                result = request(
                    "embeddings/test",
                    json.dumps({"profile": "smoke", "text": text}).encode(),
                    {"Content-Type": "application/json"},
                )
                # Core has executed embed_one and checked vector count, dimensions and finite values.
                # The API intentionally returns metadata, not coordinates or ordered batch results.
                if result != {"profile": "smoke", "dimensions": 3}:
                    raise ValueError(f"unexpected embedding result: {result}")
            print(f"Executed {plugin}/{module}: sample embeddings validated by Core")
        except BaseException:
            log.flush()
            log.seek(0)
            print(log.read(), end="")
            raise
        finally:
            daemon.terminate()
            try:
                daemon.wait(timeout=10)
            except subprocess.TimeoutExpired:
                daemon.kill()
                daemon.wait()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--archive", type=pathlib.Path)
    parser.add_argument("--plugin-id", default="embedding-conformance")
    parser.add_argument("--module-id", default="{{ module_name }}")
    args = parser.parse_args()
    binary = shutil.which(os.environ.get("MEMCASTLE_BIN", "memcastle"))
    if binary is None:
        parser.error("put migrated development Core on PATH or set MEMCASTLE_BIN")
    binary = str(pathlib.Path(binary).resolve())
    with tempfile.TemporaryDirectory(prefix="embedding-conformance-") as directory:
        scratch = pathlib.Path(directory)
        if args.archive:
            archive = args.archive.resolve()
        else:
            module = pathlib.Path(__file__).resolve().parents[1]
            wrapper = scratch / "plugin"
            relative = pathlib.Path("embeddings") / args.module_id
            staged = wrapper / relative
            staged.mkdir(parents=True)
            shutil.copyfile(module / "embedding.wasm", staged / "embedding.wasm")
            shutil.copyfile(
                module / "memcastle-embedding.toml", staged / "memcastle-embedding.toml"
            )
            # The provisional range admits migrated development Core, which still reports 0.5.2.
            (wrapper / "plugin.toml").write_text(
                'format = 1\nmemcastle = ">=0.5, <0.6"\n[plugin]\n'
                f'id = {json.dumps(args.plugin_id)}\nprovider = "conformance"\n'
                'description = "Temporary embedding conformance plugin"\n'
                'repository = "https://github.com/memcastle/memcastle-embedding-provider.tpl"\nlicense = "MIT"\n'
                '[[modules]]\ntype = "embedding_provider"\n'
                f"id = {json.dumps(args.module_id)}\n"
                f'manifest = "{relative.as_posix()}/memcastle-embedding.toml"\n'
                f'entry = "{relative.as_posix()}/embedding.wasm"\ncontract = "0.2.0"\n'
            )
            archive = scratch / "plugin.tar.gz"
            subprocess.run(
                [
                    binary,
                    "plugin",
                    "package",
                    str(wrapper / "plugin.toml"),
                    "--version",
                    "0.1.0",
                    "--output",
                    str(archive),
                ],
                check=True,
                cwd=scratch,
            )
        check(archive, args.plugin_id, args.module_id, binary, scratch)


if __name__ == "__main__":
    main()
